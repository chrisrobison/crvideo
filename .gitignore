.DS_Store
Thumbs.db
*.swp

# Local environment/secrets file(s) -- never committed.
/.env
/.env.sh

# Google Drive API key for channel.html's drive-key.php -- a secret,
# never committed. See scheduler/GOOGLE_DRIVE_SETUP.md.
/scheduler/drive-config.local.php

# Local video cache (server/download-cache.mjs) -- large, regenerated, never committed.
/cache/

# Service-account credential for the cache downloader -- a secret, never committed.
/server/service-account.json
/server/*.log

# Cron logs for the announcer worker/GC (channels/announce-worker.php,
# channels/announce-gc.php) -- operational output, never committed.
/channels/*.log

# Shared secret for the scheduler's publish endpoint -- a secret, never committed.
/server/publish-secret.php

# Backups the publish endpoint makes of playlist.json before each overwrite.
/playlist.json.bak

# Backups YouTubeSeriesWriter (youtube-import) makes of a series.json before
# each overwrite.
series/*/series.json.bak

# channels/publish.php's per-block approved-episode-set pins (EpisodeSetPin)
# and the .bak files it/ScheduleWriter leave next to schedule.json/meta.json --
# local build state, same posture as ia-import's .cache/, never committed.
channels/*/.publish/
channels/*/schedule.json.bak
channels/*/meta.json.bak

# Backups server/channel-admin.php makes of catalog.json/programming.json
# before each overwrite (admin_atomic_write_json in server/lib/AdminSupport.php).
channels/*/catalog.json.bak
channels/*/programming.json.bak

# AI continuity announcer (channels/announcer/) -- local build/queue state,
# same posture as channels/*/.publish/: never committed.
channels/*/.announcer/
channels/*/announcements.json.bak
channels/*/announcements.json.lock
channels/announcer/config.local.php

# Generated announcement MP3s -- regenerable build artifacts (see
# channels/announcer/README.md to regenerate), not committed, same
# posture as /cache/.
media/announcements/

# Kokoro TTS microservice (tools/kokoro-server/) -- large downloaded model
# files and its local Python virtualenv, never committed.
tools/kokoro-server/models/
tools/kokoro-server/.venv/
